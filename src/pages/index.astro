---
import Base from '../layouts/Base.astro';
import DayCard from '../components/DayCard.astro';
import WeekRow from '../components/WeekRow.astro';
import BannerNotice from '../components/BannerNotice.astro';
import Ikon from '../components/art/Ikon.astro';
import { TELEFON, TELEFON_HREF, SMS_HREF } from '../lib/kontakt';
import { todayInCopenhagen, timeInCopenhagen } from '../lib/datetime';
import { smsIsOpen, SMS_DEADLINE } from '../lib/preorder';
import { resolveWeek, resolveBanner } from '../lib/schedule';
import { resolveFerie } from '../lib/ferie';
import { getWeeklyStops, getUpcomingExceptions, getSettings } from '../lib/db';
import { env } from 'cloudflare:workers';
import type { DayEntry, Banner } from '../lib/types';

// Rendered on demand and never cached. An edit by the owner must be visible
// immediately — a stale cache here would send customers to the wrong place,
// which is the worst thing this site can do.
Astro.response.headers.set('Cache-Control', 'no-store');

const today = todayInCopenhagen();

let week: DayEntry[] = [];
let banner: Banner | null = null;
let failed = false;

try {
  const db = env.DB;
  const [stops, exceptions, settings] = await Promise.all([
    getWeeklyStops(db),
    getUpcomingExceptions(db, today),
    getSettings(db),
  ]);
  week = resolveWeek(today, stops, exceptions, resolveFerie(today, settings));
  banner = resolveBanner(today, settings);
} catch (error) {
  // Better to admit the schedule is unavailable than to show a blank or stale
  // one that a customer might drive to.
  console.error('Failed to load schedule', error);
  failed = true;
}

// Only used when today is closed: the first day after it that is not.
const nextOpen = week.slice(1).find((day) => !day.isClosed);

// The pre-order panel changes at 16:00 Copenhagen time, so the front page has
// to be rendered per request for it to be right — which it already is, and it
// is never cached, so there is no stale version to catch this out.
const smsAaben = smsIsOpen(timeInCopenhagen());

// Transcribed from the truck's own painted signage. Compositions only, and
// deliberately no prices — the prices are chalked on a board that changes.
// Two lines run off the edge of the photograph and are reconstructed from the
// pattern of the others; check them against the truck before go-live.
const menuer = [
  {
    navn: 'Middag for 1',
    til: '1 person',
    billede: 'pommes',
    dele: [
      '½ grillstegt BBQ-kylling',
      '1 x pommes frites eller 1 x salat',
      '1 x agurksalat & 1 x dyppelse',
    ],
  },
  {
    navn: 'Middag for 2',
    til: '2 personer',
    billede: 'coleslaw',
    dele: [
      '2 x ½ grillstegt BBQ-kylling',
      '1 x coleslaw',
      '1 x pommes frites eller 1 x salat',
      '2 x agurksalat & 2 x dyppelse',
    ],
  },
  {
    navn: 'Middag for 4',
    til: '4 personer',
    billede: 'kylling',
    dele: [
      '4 x ½ grillstegt BBQ-kylling',
      '2 x coleslaw',
      '2 x pommes frites eller 2 x salat',
      '4 x agurksalat & 2 x dyppelse',
    ],
  },
  {
    navn: 'Børnemenu',
    til: 'Børn',
    billede: 'festtelt',
    dele: ['4 x kyllingenuggets eller 4 x hot wings', '1 x pommes frites', '1 x dyppelse'],
  },
];
---

<Base title="Hvor er vi?">
  {banner && <BannerNotice text={banner.text} />}

  {/* The hero: a composite of the owner's own photos (truck + spit chickens,
      scripts/hero-composite.py), darkened on the left so the headline reads.
      The gradient overlay keeps the text at AA on phones, where the photo
      sits behind the whole block. */}
  <section data-mork class="relative isolate overflow-hidden bg-mork text-mork-tekst">
    <img
      src="/photos/hero-komp-1200.webp"
      srcset="/photos/hero-komp-1200.webp 1200w, /photos/hero-komp-2400.webp 2400w"
      sizes="100vw"
      width="2400"
      height="1000"
      fetchpriority="high"
      alt="Chicks on Wheels' foodtruck med spydstegte BBQ-kyllinger"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[72%_50%] lg:object-center"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-mork/90 via-mork/70 to-mork/20 lg:from-mork/40 lg:via-transparent lg:to-transparent"
      aria-hidden="true"
    >
    </div>

    <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:py-24">
      <h1 class="text-[clamp(2.75rem,1.4rem+6vw,6rem)] leading-[0.92] uppercase">
        <span class="block">Kylling fra</span>
        <span class="block text-orange">spyddet</span>
      </h1>
      <div class="mt-6 h-1.5 w-40 rounded-full bg-orange sm:w-64" aria-hidden="true"></div>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href="#menu"
          class="flex min-h-12 items-center justify-center gap-2.5 rounded-lg bg-orange px-6 py-3 text-base font-bold text-tekst hover:bg-orange-dyb hover:text-white"
        >
          <Ikon navn="seddel" class="h-5 w-5 shrink-0" />
          Se menuen
        </a>
        <a
          href="#forudbestilling"
          class="flex min-h-12 items-center justify-center gap-2.5 rounded-lg border-2 border-mork-tekst px-6 py-3 text-base font-bold text-mork-tekst hover:bg-mork-tekst hover:text-tekst"
        >
          <Ikon navn="telefon" class="h-5 w-5 shrink-0" />
          Forudbestilling
        </a>
      </div>
    </div>
  </section>

  {/* What he sells, at a glance. */}
  <section data-mork aria-label="Det laver vi" class="border-t border-white/10 bg-mork text-mork-tekst">
    <ul class="mx-auto flex w-full max-w-6xl flex-wrap justify-center px-4 py-4 sm:px-6 lg:flex-nowrap lg:divide-x lg:divide-white/15">
      {[
        { ikon: 'kylling', tekst: 'Spydstegt BBQ-kylling' },
        { ikon: 'pommes', tekst: 'Pommes frites' },
        { ikon: 'skaal', tekst: 'Coleslaw & salater' },
        { ikon: 'fest', tekst: 'Fester & firmaer' },
        { ikon: 'vogn', tekst: 'Foodtruck & pølsevogn' },
      ].map((p) => (
        <li class="flex w-1/3 flex-col items-center gap-2 px-2 py-3 text-center text-sm font-bold leading-tight lg:w-auto lg:flex-1 lg:flex-row lg:justify-center lg:gap-3 lg:text-left lg:text-base">
          <Ikon navn={p.ikon as 'kylling'} class="h-8 w-8 shrink-0 text-orange" />
          <span>{p.tekst}</span>
        </li>
      ))}
    </ul>
  </section>

  <section id="plan" aria-labelledby="find-titel">
    <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <h2 id="find-titel" class="text-center text-h2">Find os</h2>

      {
        failed ? (
          <div class="mx-auto mt-8 max-w-xl rounded-2xl bg-flade p-6">
            <h3 class="font-display text-h3">Planen kan ikke vises lige nu.</h3>
            <p class="mt-3 text-lg">
              Prøv igen om et øjeblik, eller ring til os på{' '}
              <a
                href={TELEFON_HREF}
                class="font-semibold text-orange-dyb tabular-nums underline decoration-2 underline-offset-4"
              >
                {TELEFON}
              </a>
              .
            </p>
          </div>
        ) : (
          <div class="mt-8 grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-10">
            <DayCard day={week[0]} next={nextOpen} />

            <section aria-labelledby="resten-af-ugen" class="flex flex-col">
              <h3
                id="resten-af-ugen"
                class="font-sans text-etiket font-bold text-daempet uppercase"
              >
                Resten af ugen
              </h3>
              <ul class="mt-3 grid flex-1 auto-rows-fr grid-cols-2 gap-3 sm:grid-cols-3">
                {week.slice(1).map((day) => (
                  <WeekRow day={day} />
                ))}
              </ul>
            </section>
          </div>
        )
      }
    </div>
  </section>

  <section id="menu" aria-labelledby="menu-titel" class="bg-flade">
    <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6">
      <h2 id="menu-titel" class="text-center text-h2">Menu</h2>
      {/* One card per menu. On a phone they sit in a row that snaps each card
          to the centre, with its neighbours peeking in on both sides; swipe
          works without JS, and the arrow buttons appear only once the small
          script below has run. From md up the cards are a plain grid.
          Pictures are the reference site's illustrations, used with the
          owner's consent (user's call, 2026-11-21). */}
      <div data-karrusel class="relative -mx-4 mt-6 sm:-mx-6 md:mx-0">
        <div
          data-spor
          id="menu-spor"
          role="region"
          aria-labelledby="menu-titel"
          tabindex="0"
          class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-[10%] pt-8 pb-6 [scrollbar-width:none] md:grid md:grid-cols-2 md:gap-6 md:overflow-visible md:px-0 lg:grid-cols-4 [&::-webkit-scrollbar]:hidden"
        >
          {menuer.map((menu) => (
            <article class="relative w-full shrink-0 snap-center rounded-2xl border border-kant bg-kort p-5 pt-7 shadow-[0_6px_18px_-8px_rgb(42_20_12/0.25)]">
              <img
                src={`/photos/menu/${menu.billede}.webp`}
                alt=""
                width="200"
                height="200"
                loading="lazy"
                class="absolute -top-7 right-4 h-24 w-24 rounded-full border-[5px] border-white object-cover shadow-[0_4px_12px_-2px_rgb(42_20_12/0.35)]"
              />
              <p class="inline-block rounded-full bg-orange px-3 py-0.5 text-sm font-bold text-tekst">
                {menu.til}
              </p>
              <h3 class="mt-7 text-h3">{menu.navn}</h3>
              <ul class="mt-3 flex flex-col gap-2.5 text-base font-medium">
                {menu.dele.map((del) => (
                  <li class="flex gap-2.5">
                    {/* White tick on orange is a graphic at 3.35:1 (needs 3:1). */}
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-orange text-white" aria-hidden="true">
                      <Ikon navn="flueben" class="h-3 w-3" />
                    </span>
                    <span>{del}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <button
          type="button"
          data-forrige
          hidden
          aria-controls="menu-spor"
          aria-label="Forrige menu"
          class="absolute top-1/2 left-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-kant bg-white text-tekst shadow-[0_4px_12px_-4px_rgb(42_20_12/0.4)] disabled:opacity-40 md:!hidden"
        >
          <Ikon navn="venstre" class="h-5 w-5" />
        </button>
        <button
          type="button"
          data-naeste
          hidden
          aria-controls="menu-spor"
          aria-label="Næste menu"
          class="absolute top-1/2 right-2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full border border-kant bg-white text-tekst shadow-[0_4px_12px_-4px_rgb(42_20_12/0.4)] disabled:opacity-40 md:!hidden"
        >
          <Ikon navn="hoejre" class="h-5 w-5" />
        </button>
      </div>
    </div>
  </section>

  <script>
    // Progressive enhancement: without this the row still swipes. The arrows
    // move one card and disable themselves at either end.
    for (const k of document.querySelectorAll<HTMLElement>('[data-karrusel]')) {
      const spor = k.querySelector<HTMLElement>('[data-spor]')!;
      const forrige = k.querySelector<HTMLButtonElement>('[data-forrige]')!;
      const naeste = k.querySelector<HTMLButtonElement>('[data-naeste]')!;
      const roligt = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const skridt = () => (spor.firstElementChild as HTMLElement).offsetWidth + 16;
      const opdater = () => {
        forrige.disabled = spor.scrollLeft < 4;
        naeste.disabled = spor.scrollLeft + spor.clientWidth > spor.scrollWidth - 4;
      };
      const flyt = (retning: number) =>
        spor.scrollBy({ left: retning * skridt(), behavior: roligt ? 'auto' : 'smooth' });
      forrige.addEventListener('click', () => flyt(-1));
      naeste.addEventListener('click', () => flyt(1));
      spor.addEventListener('scroll', opdater, { passive: true });
      forrige.hidden = naeste.hidden = false;
      opdater();
    }
  </script>

  <section
    id="forudbestilling"
    aria-labelledby="forudbestilling-titel"
  >
    <div class="mx-auto w-full max-w-6xl px-4 py-12 sm:px-6 lg:py-16">
      <div class="text-center">
        <h2 id="forudbestilling-titel" class="text-h2">Forudbestilling</h2>
        <p class="mt-3 text-lg font-semibold">Ring og bestil, så står maden klar, når du kommer.</p>
      </div>

      <div class="mt-10 grid gap-6 lg:grid-cols-2 lg:gap-10">
        {/* The two rules, as cards with an orange icon disc. */}
        <div class="grid gap-4">
        <dl class="contents">
          <div class="flex gap-4 rounded-2xl border border-kant bg-kort p-5 shadow-[0_6px_18px_-10px_rgb(42_20_12/0.3)] sm:p-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange text-tekst" aria-hidden="true">
              <Ikon navn="telefon" class="h-6 w-6" />
            </span>
            <div>
              <dt class="font-display text-h3">Fra dagen før</dt>
              <dd class="mt-1 text-base">Telefonen er åben for bestillinger allerede dagen før.</dd>
            </div>
          </div>
          <div class="flex gap-4 rounded-2xl border border-kant bg-kort p-5 shadow-[0_6px_18px_-10px_rgb(42_20_12/0.3)] sm:p-6">
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-orange text-tekst" aria-hidden="true">
              <Ikon navn="ur" class="h-6 w-6" />
            </span>
            <div>
              <dt class="font-display text-h3">SMS indtil kl. {SMS_DEADLINE}</dt>
              <dd class="mt-1 text-base">
                SMS-bestillinger er åbne frem til kl. {SMS_DEADLINE} på dagen. Derefter kun
                bestilling via opkald.
              </dd>
            </div>
          </div>
        </dl>
          <p class="px-1 text-base text-daempet">
            <a href="#plan" class="underline decoration-2 underline-offset-4 hover:text-tekst"
              >Se ugeplanen for at finde os i denne uge.</a
            >
          </p>
        </div>

        {/* The call card: what is possible right now, then the number. */}
        <div
          data-mork
          class="flex flex-col rounded-2xl bg-mork p-6 text-mork-tekst shadow-[0_10px_30px_-12px_rgb(42_20_12/0.55)] sm:p-8"
        >
          <p
            class:list={[
              'flex items-start gap-3 rounded-lg px-4 py-3 text-base font-bold',
              smsAaben ? 'bg-white/10 text-mork-tekst' : 'bg-fare text-white',
            ]}
          >
            <span
              class:list={['mt-1.5 h-2.5 w-2.5 shrink-0 rounded-full', smsAaben ? 'bg-orange' : 'bg-white']}
              aria-hidden="true"></span>
            {
              smsAaben
                ? `Lige nu: du kan både ringe og sende SMS indtil kl. ${SMS_DEADLINE}.`
                : 'Lige nu: klokken er over ' + SMS_DEADLINE + ' — ring til os, SMS bliver ikke læst i dag.'
            }
          </p>

          <p class="mt-6 text-etiket font-bold text-mork-daempet uppercase">Ring og bestil</p>
          <a
            href={TELEFON_HREF}
            class="mt-1 font-display text-[clamp(1.4rem,0.6rem+4vw,2.75rem)] leading-tight whitespace-nowrap text-orange tabular-nums hover:text-mork-tekst"
            >{TELEFON}</a
          >

          <div class="flex-1" aria-hidden="true"></div>

          <div class="mt-6 flex flex-col gap-3 sm:flex-row">
            <a
              href={TELEFON_HREF}
              class="flex min-h-12 flex-1 items-center justify-center gap-2.5 rounded-lg bg-orange px-5 py-3 text-base font-bold text-tekst hover:bg-orange-dyb hover:text-white"
            >
              <Ikon navn="telefon" class="h-5 w-5" />
              Ring nu
            </a>
            {
              smsAaben && (
                <a
                  href={SMS_HREF}
                  class="flex min-h-12 flex-1 items-center justify-center gap-2.5 rounded-lg border-2 border-mork-tekst px-5 py-3 text-base font-bold text-mork-tekst hover:bg-mork-tekst hover:text-tekst"
                >
                  <Ikon navn="post" class="h-5 w-5" />
                  Send SMS
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
