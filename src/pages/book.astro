---
import Base from '../layouts/Base.astro';
import Ikon from '../components/art/Ikon.astro';
import { TELEFON, TELEFON_HREF, SMS_HREF, EMAIL } from '../lib/kontakt';
import { BOOKING_PUNKTER, bookingMailto } from '../lib/booking';

export const prerender = true;

const mailto = bookingMailto(EMAIL);

const trin = [
  { titel: 'Ring eller skriv', tekst: 'Fortæl os dato, sted og cirka hvor mange I bliver.' },
  { titel: 'Få et tilbud', tekst: 'Vi aftaler menu og tidspunkt og sender en pris.' },
  { titel: 'Vi kommer og laver maden', tekst: 'Vognen holder klar på dagen, og vi står for resten.' },
];
---

<Base
  title="Book os"
  description="Book Chicks on Wheels' foodtruck eller pølsevogn til dit arrangement."
>
  <div class="mx-auto w-full max-w-6xl px-4 pt-8 pb-14 sm:px-6 sm:pt-10 sm:pb-16">
    <h1 class="text-h1">Book os</h1>
    <p class="mt-4 max-w-2xl text-lg">
      Ring eller skriv til os med dato, sted og antal gæster – så vender vi tilbage med et tilbud.
    </p>
    {/* The weekly stops are around Fredericia, but bookings cover all of Denmark. */}
    <p class="mt-4 flex max-w-2xl items-start gap-3 rounded-2xl bg-flade px-5 py-4 text-base">
      <Ikon navn="vogn" class="mt-0.5 h-6 w-6 shrink-0 text-orange-dyb" />
      <span>
        <strong>Vi kommer i hele Danmark.</strong> Fortæl os, hvor arrangementet er,
        så finder vi en løsning.
      </span>
    </p>

    <section aria-labelledby="trin-titel" class="mt-10">
      <h2 id="trin-titel" class="text-h2">Sådan booker du</h2>
      {/* Side by side from md up, stacked on a phone. */}
      <ol class="mt-5 grid gap-3 md:grid-cols-3 md:gap-4">
        {
          trin.map((t, n) => (
            <li class="flex gap-4 rounded-2xl border border-kant bg-kort p-5 shadow-[0_6px_18px_-10px_rgb(42_20_12/0.3)] md:flex-col md:gap-3">
              <span
                class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange font-display text-lg text-tekst"
                aria-hidden="true"
              >
                {n + 1}
              </span>
              <span>
                <span class="block text-lg font-bold">{t.titel}</span>
                <span class="mt-1 block text-base text-daempet">{t.tekst}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <aside class="flex min-w-0 flex-col gap-4 lg:order-2 lg:sticky lg:top-6 lg:self-start">
        <section class="rounded-2xl bg-flade p-5">
          <h2 class="text-h3">Ring eller send SMS</h2>
          <p class="mt-2">Den hurtigste vej til en booking.</p>
          <div class="mt-4 flex flex-col gap-3">
            <a
              href={TELEFON_HREF}
              class="flex min-h-12 items-center justify-center gap-2.5 rounded-lg bg-orange px-5 py-3 text-base font-bold text-tekst hover:bg-orange-dyb hover:text-white"
            >
              <Ikon navn="telefon" class="h-5 w-5" />
              <span class="tabular-nums">{TELEFON}</span>
            </a>
            <a
              href={SMS_HREF}
              class="flex min-h-12 items-center justify-center gap-2.5 rounded-lg border-2 border-tekst px-5 py-3 text-base font-bold hover:bg-tekst hover:text-creme"
            >
              <Ikon navn="post" class="h-5 w-5" />
              Send SMS
            </a>
          </div>
        </section>
        <section class="rounded-2xl bg-flade p-5">
          <h2 class="text-h3">Skriv til os</h2>
          <p class="mt-2">
            <a
              href={`mailto:${EMAIL}`}
              class="inline-flex min-h-12 items-center font-bold text-orange-dyb underline underline-offset-4 [overflow-wrap:anywhere]"
            >
              {EMAIL}
            </a>
          </p>
        </section>
      </aside>

      <div class="min-w-0 max-w-2xl">
        <h2 class="text-h2">Det skal vi vide</h2>
        <p class="mt-4">Fortæl os det her, når du ringer eller skriver:</p>
        <ul class="mt-3 list-disc space-y-1 pl-6">
          {BOOKING_PUNKTER.map((p) => <li>{p}</li>)}
        </ul>
        <a
          href={mailto}
          class="mt-6 flex min-h-12 items-center justify-center gap-2.5 rounded-lg bg-orange px-5 py-3 text-base font-bold text-tekst hover:bg-orange-dyb hover:text-white sm:inline-flex"
        >
          <Ikon navn="post" class="h-5 w-5" />
          Skriv en mail
        </a>
        <p class="mt-6">Book i god tid – især til weekender og i højsæsonen.</p>
      </div>
    </div>
  </div>
</Base>
