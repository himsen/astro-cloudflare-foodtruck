---
import Field from './Field.astro';
import type { WeeklyStop } from '../../lib/types';
import { DANISH_WEEKDAYS } from '../../lib/datetime';

interface Props {
  stop: WeeklyStop;
  errors?: Record<string, string>;
  /**
   * The checkbox as she left it. Only passed when re-rendering a failed POST —
   * an empty day she had just un-ticked has no location to infer it from, and
   * silently re-ticking it would contradict the errors shown beside it.
   */
  closed?: boolean;
}

const { stop, errors = {}, closed = stop.location_name === null } = Astro.props;
const w = stop.weekday;
---

<fieldset class="border-2 border-tekst bg-papir px-4 pt-2 pb-5 sm:px-5">
  <legend class="bg-mork px-3 py-1.5 text-base font-black tracking-[0.1em] text-mork-tekst uppercase">
    {DANISH_WEEKDAYS[w]}
  </legend>

  <input type="hidden" name={`weekday_${w}`} value={String(w)} />

  <label
    class="mt-3 flex min-h-12 items-center gap-3 border-2 border-tekst bg-creme px-4 py-3 text-base font-bold"
  >
    <input
      type="checkbox"
      name={`closed_${w}`}
      checked={closed}
      class="h-6 w-6 shrink-0 accent-fare"
    />
    Lukket denne dag
  </label>

  <div class="mt-4 grid gap-4 sm:grid-cols-2">
    <Field label="Sted" name={`location_name_${w}`} value={stop.location_name} error={errors.location_name} placeholder="F.eks. Torvet" />
    <Field label="Adresse" name={`address_${w}`} value={stop.address} placeholder="F.eks. Torvet 1" />
    <Field label="Fra kl." name={`start_time_${w}`} value={stop.start_time} error={errors.start_time} placeholder="11:00" />
    <Field label="Til kl." name={`end_time_${w}`} value={stop.end_time} error={errors.end_time} placeholder="14:00" />
    <Field label="Link til kort (valgfrit)" name={`map_url_${w}`} value={stop.map_url} />
    <Field label="Bemærkning (valgfrit)" name={`note_${w}`} value={stop.note} />
  </div>
</fieldset>
