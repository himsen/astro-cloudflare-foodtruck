---
import Ikon from './art/Ikon.astro';
import { TELEFON, TELEFON_HREF } from '../lib/kontakt';
---

<div data-mork class="fixed inset-x-0 bottom-0 z-40 sm:hidden">
  <a
    data-ringebar
    href={TELEFON_HREF}
    class="flex focus-visible:outline-offset-[-5px] min-h-[calc(3rem+env(safe-area-inset-bottom))] items-center justify-center gap-2 bg-mork px-4 pb-[env(safe-area-inset-bottom)] text-base font-bold text-mork-tekst"
  >
    <Ikon navn="telefon" class="h-5 w-5" />
    Ring {TELEFON}
  </a>
</div>
