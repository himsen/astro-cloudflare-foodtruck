---
/**
 * The hen, drawn once.
 *
 * Renders a bare <g> on a 0 0 120 120 grid so it can be dropped inside any
 * other drawing at any scale — she stands on the truck's roof sign and on the
 * owner's shoulder. Colours come from CSS custom properties set by whatever
 * contains her, so the same hen works on bone, on yellow and on black.
 */
---

<g
  fill="none"
  stroke="var(--streg, #111111)"
  style="stroke-width: var(--stregbredde, 5)"
  stroke-linejoin="round"
  stroke-linecap="round"
>
  <path d="M32 68C14 60 8 38 14 20c8 14 20 20 30 22z" fill="var(--krop, #e8341f)"></path>
  <ellipse cx="60" cy="72" rx="32" ry="24" fill="var(--krop, #e8341f)"></ellipse>
  <path d="M46 66c9 11 21 13 29 6"></path>
  <circle cx="86" cy="42" r="15" fill="var(--krop, #e8341f)"></circle>
  <path d="M76 30c0-7 7-10 10-4 2-6 9-6 10 0 3-4 9-1 7 6" fill="var(--kam, #ffc526)"></path>
  <path d="M100 41l14 5-14 6z" fill="var(--kam, #ffc526)"></path>
  <path d="M92 55c6 4 4 11-2 11s-7-6-3-9" fill="var(--kam, #ffc526)"></path>
  <circle cx="89" cy="38" r="3" fill="var(--streg, #111111)" stroke="none"></circle>
  <path d="M50 94v12M50 106l-9 7M50 106l9 7M72 94v12M72 106l-9 7M72 106l9 7"></path>
</g>
